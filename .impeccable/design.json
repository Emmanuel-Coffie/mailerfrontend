  "narrative": {
    "northStar": "The Correspondence Studio",
    "overview": "A calm operations workspace opens into a spacious email workbench. Ink teal navigation, cool porcelain surfaces and pale eucalyptus selections give dense campaign information a clear hierarchy. Manrope headings and Inter body text make the interface feel composed and practical.\n\nThe supplied logo remains the identity anchor. `public/brand-logo.jpg` is the exact user asset, unchanged; do not redraw or recolor it. Starter email artwork is composed from HTML and CSS, with muted content-specific colors.",
    "keyCharacteristics": [
      "Ink teal navigation and flat bordered work surfaces.",
      "Manrope headings paired with compact Inter interface text.",
      "A selectable email canvas with a contextual inspector."
    ],
    "rules": [
      {
        "name": "The Shared Palette Rule",
        "body": "Change shared colors in the theme and preserve the CSS variable bridge.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do reuse theme colors through the CSS variable bridge.",
      "Do preserve the exact supplied logo asset.",
      "Do retain keyboard focus, reduced-motion and forced-colors treatments.",
      "Do keep email rendering independent of application web fonts."
    ],
    "donts": [
      "Don't create page-specific replacements for shared form and table behaviors.",
      "Don't replace existing HTML silently when opening the visual designer.",
      "Don't claim demo previews verify delivery or rendering in every email client."
    ]
  }
